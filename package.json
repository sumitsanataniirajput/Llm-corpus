{
  "name": "corpus-ultimate",
  "version": "1.0.0",
  "private": true,
  "description": "CORPUS ULTIMATE — frontend test tooling (the app itself is dependency-free vanilla JS)",
  "scripts": {
    "test": "node --test frontend/tests/*.test.mjs scripts/tests/*.test.mjs",
    "test:frontend": "node --test frontend/tests/*.test.mjs",
    "test:deployment": "node --test scripts/tests/*.test.mjs",
    "test:docs": "node --test scripts/tests/repo-hygiene.test.mjs",
    "test:baseline": "node scripts/check-test-baseline.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test:ci": "npm run check:migrations && npm run test:docs && npm run test:baseline",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.1",
    "chart.js": "4.4.0",
    "jsdom": "^24.1.3"
  }
}
