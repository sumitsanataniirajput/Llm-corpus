# ========================================
# CORPUS ULTIMATE — Backend Environment
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to version control.
# The placeholders below are deliberately NOT usable secrets: the startup
# validators reject empty / default values, and Render supplies the real ones.
# ========================================

# --- Server ---
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,corpus-ultimate-api.onrender.com
# Comma-separated IPs of proxies allowed to set X-Forwarded-For.
# Leave empty unless the app is actually behind a trusted reverse proxy.
TRUSTED_PROXY_IPS=
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Supabase (required) ---
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Anon (public) key — safe to use in frontend with RLS
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY
# Modern publishable key (same public key as SUPABASE_ANON_KEY)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_KEY
# Service-role key — BACKEND ONLY, never expose to frontend
# Get from: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# --- Database ---
# PostgreSQL connection string (Supabase)
# Get from: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.your-project-ref:REPLACE_WITH_PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# --- Security ---
# Secret for signing internal app JWTs. Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Shared secret for worker registration. Generate with: openssl rand -hex 32
WORKER_AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
# 32 random bytes, base64 or hex, for AES-256-GCM provider credentials.
# Generate with: openssl rand -hex 32
# When empty, saving a provider credential is refused instead of storing it
# insecurely (see app/services/crypto.py).
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_OR_HEX

# --- API ---
# Base URL of the backend (use the Render URL in production)
API_BASE_URL=https://corpus-ultimate-api.onrender.com
# CORS origins (comma-separated). Include the deployed frontend and local dev.
CORS_ORIGINS=https://corpus-ultimate-web.onrender.com,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---
# Supabase storage bucket for models/datasets/checkpoints
STORAGE_BUCKET=corpus-storage
# Max upload size in bytes for the small fallback multipart route (6 MiB).
# Normal browser uploads use direct TUS and are not limited by this value.
MAX_UPLOAD_SIZE=6291456

# --- Resource limits ---
# Max model parameters allowed without explicit confirmation
MAX_PARAMETERS_DEFAULT=100000000
# Max context length
MAX_CONTEXT_LENGTH=4096
# Max vocab size
MAX_VOCAB_SIZE=100000

# --- Logging ---
LOG_LEVEL=INFO

# --- Training ---
# The worker trains in-process on CPU. Cloud/device workers currently only
# preprocess data; they do not run gradient training or synchronize gradients.
DEFAULT_DEVICE=cpu
