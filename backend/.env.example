# ========================================
# CORPUS ULTIMATE — Backend Environment
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to version control.
# ========================================

# --- Server ---
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,your-hopeweb-domain.com

# --- Supabase (required) ---
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Anon (public) key — safe to use in frontend with RLS
SUPABASE_ANON_KEY=your-supabase-anon-key
# Modern publishable key (same as SUPABASE_ANON_KEY)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# Service-role key — BACKEND ONLY, never expose to frontend
# Get from: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Database ---
# PostgreSQL connection string (Supabase)
# Get from: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# --- Security ---
# Secret for signing JWT tokens (generate a strong random value)
# Use: openssl rand -hex 32
SECRET_KEY=change-me-to-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Worker authentication ---
# Shared secret for worker registration
WORKER_AUTH_SECRET=change-me-to-a-worker-secret

# --- API ---
# Base URL of the backend
API_BASE_URL=http://localhost:8000
# CORS origins (comma-separated, e.g. https://your-hopeweb-site.com,http://localhost:5173)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Storage ---
# Supabase storage bucket for models/datasets/checkpoints
STORAGE_BUCKET=corpus-storage
# Max upload size in bytes (default 100 MB)
MAX_UPLOAD_SIZE=104857600

# --- Resource limits ---
# Max model parameters allowed without explicit confirmation
MAX_PARAMETERS_DEFAULT=100000000
# Max context length
MAX_CONTEXT_LENGTH=4096
# Max vocab size
MAX_VOCAB_SIZE=100000

# --- Logging ---
LOG_LEVEL=INFO

# --- Training ---
# Default device (cpu, cuda, mps)
DEFAULT_DEVICE=cpu
