# Edge Function secrets. Set them with:  supabase secrets set NAME=value
# or Dashboard > Edge Functions > Secrets.  NEVER put these in web/ or android/.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically.

# Browser origins allowed to call the functions (comma separated). Set this in production.
ALLOWED_ORIGINS=https://your-console-domain.example

# --- SMS (ride OTP). One of: msg91 | twilio | fast2sms ---
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_TEMPLATE_ID=
SMS_WEBHOOK_TOKEN=
SMS_STATUS_CALLBACK_URL=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Google Maps (server key: Routes + Geocoding; restrict by API, not by referrer) ---
GOOGLE_MAPS_SERVER_KEY=

# --- Push (paste the whole Firebase service-account JSON on one line) ---
FIREBASE_SERVICE_ACCOUNT=

# --- E-mail (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Optional ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
